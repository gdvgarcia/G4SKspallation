# Macro file for the scoring setting in the initialization phase 
# of the G4SKspallation
#
# define scoring mesh_1 for quantities that we want spatial distribution
/score/create/boxMesh boxMesh_1
/score/mesh/boxSize 21. 21. 21. m
/score/mesh/nBin 84 84 84
#precision only in longitudinal (z or tank axis)
#/score/mesh/nBin 1 1 4200
# define quantities to be scored
/score/quantity/energyDeposit eDep MeV
/score/close
#
#
#
# --- Save results of scoring in a file - use it in the UI interface and do not uncomment here
#/score/dumpQuantityToFile boxMesh_1 <scorer_name> <file_name>
#---- Drawing the scoring mesh full projection
#/score/drawProjection boxMesh_1 eDep
#---- Drawing the scoring mesh per columns
#/score/drawColumn boxMesh_1 eDep <plane> <column>
#
#
#
# define scoring mesh_2 for quantities that we only want energy distribution
/score/create/boxMesh boxMesh_2
/score/mesh/boxSize 21. 21. 21. m
/score/mesh/nBin 1 1 1
#precision only in longitudinal (z or tank axis)
#/score/mesh/nBin 1 1 4200
#
#
# define quantities to be scored
# total of electrons still have issues about total getting in or appearing inside
# to solve this issue, one can create a mesh over the tank taking the initial vertex in and then compute
# the number of secondaries - the number of therminated track , so we find the number that arrived in the sk
# from outside colision vertex
#
#
#
#
#
# neutron total
/score/quantity/nOfSecondary nOfSecondaryNeutron
/score/filter/particle eMinusFilter neutron
# neutron energy distribution score
/score/quantity/nOfSecondary nOfSecondaryNeutron_12.5
/score/filter/particleWithKineticEnergy range0 0. 25. MeV neutron
/score/quantity/nOfSecondary nOfSecondaryNeutron_37.5
/score/filter/particleWithKineticEnergy range1 25. 50. MeV neutron
/score/quantity/nOfSecondary nOfSecondaryNeutron_62.5
/score/filter/particleWithKineticEnergy range2 50. 75. MeV neutron
/score/quantity/nOfSecondary nOfSecondaryNeutron_87.5
/score/filter/particleWithKineticEnergy range3 75. 100. MeV neutron
/score/quantity/nOfSecondary nOfSecondaryNeutron_112.5
/score/filter/particleWithKineticEnergy range4 100. 125. MeV neutron
/score/quantity/nOfSecondary nOfSecondaryNeutron_137.5
/score/filter/particleWithKineticEnergy range5 125. 150. MeV neutron
/score/quantity/nOfSecondary nOfSecondaryNeutron_162.5
/score/filter/particleWithKineticEnergy range6 150. 175. MeV neutron
/score/quantity/nOfSecondary nOfSecondaryNeutron_187.5
/score/filter/particleWithKineticEnergy range7 175. 200. MeV neutron
/score/quantity/nOfSecondary nOfSecondaryNeutron_212.5
/score/filter/particleWithKineticEnergy range8 200. 225. MeV neutron
/score/quantity/nOfSecondary nOfSecondaryNeutron_237.5
/score/filter/particleWithKineticEnergy range9 225. 250. MeV neutron
/score/quantity/nOfSecondary nOfSecondaryNeutron_262.5
/score/filter/particleWithKineticEnergy range10 250. 275. MeV neutron
/score/quantity/nOfSecondary nOfSecondaryNeutron_287.5
/score/filter/particleWithKineticEnergy range11 275. 300. MeV neutron
/score/quantity/nOfSecondary nOfSecondaryNeutron_312.5
/score/filter/particleWithKineticEnergy range12 300. 325. MeV neutron
/score/quantity/nOfSecondary nOfSecondaryNeutron_337.5
/score/filter/particleWithKineticEnergy range13 325. 350. MeV neutron
/score/quantity/nOfSecondary nOfSecondaryNeutron_362.5
/score/filter/particleWithKineticEnergy range14 350. 375. MeV neutron
/score/quantity/nOfSecondary nOfSecondaryNeutron_387.5
/score/filter/particleWithKineticEnergy range15 375. 400. MeV neutron
/score/quantity/nOfSecondary nOfSecondaryNeutron_412.5
/score/filter/particleWithKineticEnergy range16 400. 425. MeV neutron
/score/quantity/nOfSecondary nOfSecondaryNeutron_437.5
/score/filter/particleWithKineticEnergy range17 425. 450. MeV neutron
/score/quantity/nOfSecondary nOfSecondaryNeutron_462.5
/score/filter/particleWithKineticEnergy range18 450. 475. MeV neutron
/score/quantity/nOfSecondary nOfSecondaryNeutron_487.5
/score/filter/particleWithKineticEnergy range19 475. 500. MeV neutron
